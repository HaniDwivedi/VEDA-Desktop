{
  "name": "desktop",
  "version": "1.0.0",
  "description": "An Electron application with React",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev:backend": "py -3 ../backend/main.py",
    "dev:electron": "electron-vite dev",
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "build:backend": "node scripts/build-backend.js",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build:backend && npm run build && node scripts/build-release.js --win portable && node scripts/write-release-manifest.js",
    "build:win:installer": "npm run build:backend && npm run build && node scripts/build-release.js --win nsis && node scripts/write-release-manifest.js",
    "build:mac": "npm run build:backend && npm run build && node scripts/build-release.js --mac dmg && node scripts/write-release-manifest.js",
    "build:linux": "npm run build:backend && npm run build && node scripts/build-release.js --linux && node scripts/write-release-manifest.js",
    "dist": "npm run build:win"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.3.9",
    "prop-types": "^15.8.1",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "js-yaml": "^5.4.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  }
}
