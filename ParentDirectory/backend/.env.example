# Explicit app open/close commands work without an AI key. Natural-language
# requests use the user's Gemini key, encrypted in the desktop app's user data.
# In production, set VEDA_ENV=production, provide a 32+ character JWT secret,
# and configure HTTPS origins. Keep real secrets in .env or the host environment.
VEDA_ENV=development
VEDA_HOST=127.0.0.1
VEDA_PORT=8010
VEDA_DATA_DIR=
VEDA_CORS_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
# Optional in development; Redis is required for production WebSocket tickets.
VEDA_REDIS_URL=redis-cli -u redis://default:9ijoYic2hWdXp8DxfjFA27FNDzJMnP99@baseball-story-discovery-83505.db.redis.io:11879
VEDA_JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
VEDA_ALLOW_SCREEN_CONTEXT=false